# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
# Lo leen Docker Compose y el backend (spring.config.import en application.yml).

# Base de datos
DB_NAME=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=ecommerce
DB_PORT=5432

# Clave para firmar los access tokens JWT. Mínimo 32 caracteres.
# Genera una con: openssl rand -base64 48
JWT_SECRET=

# Primer usuario ADMIN. Solo se crea si todavía no existe ningún ADMIN.
ADMIN_EMAIL=admin@techstore.local
ADMIN_PASSWORD=
